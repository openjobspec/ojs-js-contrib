  },
  "devDependencies": {
    "@openjobspec/sdk": "file:vendor/openjobspec-sdk-0.5.0.tgz",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
