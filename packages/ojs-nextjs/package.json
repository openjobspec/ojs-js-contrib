{
  "name": "@openjobspec/nextjs",
  "version": "0.5.0",
  "description": "Next.js helpers for OpenJobSpec",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./routes": { "types": "./dist/routes.d.ts", "default": "./dist/routes.js" },
    "./worker": { "types": "./dist/worker.d.ts", "default": "./dist/worker.js" },
    "./middleware": { "types": "./dist/middleware.d.ts", "default": "./dist/middleware.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": ["openjobspec", "ojs", "nextjs", "server-actions", "background-jobs"],
  "repository": {
    "type": "git",
    "url": "https://github.com/openjobspec/ojs-js-contrib",
    "directory": "packages/ojs-nextjs"
  },
  "homepage": "https://github.com/openjobspec/ojs-js-contrib/tree/main/packages/ojs-nextjs#readme",
  "bugs": "https://github.com/openjobspec/ojs-js-contrib/issues",
  "peerDependencies": {
    "@openjobspec/sdk": "^0.5.0",
    "next": "^16.3.4"
  },
  "devDependencies": {
    "@openjobspec/sdk": "^0.5.0",
    "@types/react": "^19.2.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
